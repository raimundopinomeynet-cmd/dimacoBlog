{
    "store.custom#cotiza": {
		"blocks": [
            "flex-layout.row#cotiza__main"
        ]
	},
    "flex-layout.row#cotiza__main": {
        "props": {
            "blockClass": "cotiza__main"
        },
        "children": [
            "flex-layout.col#cotiza__main"
        ]
    },
    "flex-layout.col#cotiza__main": {
        "children": [
             "rich-text#title__cotiza",
             "rich-text#body__cotiza",
             "rich-text#vendedor__cotiza",
             "flex-layout.col#cards__vendedores__ferre",
              "rich-text#vendedor__empresa",
              "flex-layout.col#cards__vendedores__empresa",
               "rich-text#localidad__zona",
               "flex-layout.col#localidad__zona"
        ],
        "props": {
            "blockClass": "cotiza__main"
        }
    },
    "rich-text#title__cotiza": {
        "props": {
            "text": "Cotiza Con Nosotros",
            "blockClass": "title__cotiza"
        }
    },
    "rich-text#body__cotiza": {
        "props": {
            "text": "En <span class='vtex-rich-text-0-x-paragraph--parrafo__landing__bold__span'>Dimaco</span> , contamos con un equipo especializado para atender las necesidades de <span class='vtex-rich-text-0-x-paragraph--parrafo__landing__bold__span'>ferreterías, contratistas y empresas. </span> Encuentra al vendedor correspondiente según tu tipo de negocio, para que puedan ofrecerte una amplia gama de productos y servicios, adaptados a tus necesidades y proyectos. Nuestro objetivo es acompañarte en cada etapa, asegurando que encuentres las mejores soluciones y productos para alcanzar tus metas de forma fácil y eficiente.",
            "blockClass": "body__cotiza" 
        }
    },
    /* TITULO DE  CONTENEDOR DE CARDS */
    "rich-text#vendedor__cotiza": {
        "props": {
            "text": "Vendedores para Ferreterías y Contratistas",
            "blockClass": "vendedor__cotiza"
        }
    },
