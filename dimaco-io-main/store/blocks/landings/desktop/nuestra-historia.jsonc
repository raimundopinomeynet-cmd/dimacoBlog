        }
    },
    "rich-text#parrafo__1__landing__historia": {
        "props": {
            "text": "**Resumen de la historia de Dimaco**",
            "blockClass": "parrafo__landing"
        }
    },
    "rich-text#parrafo__2__landing__historia": {
        "props": {
            "text": "**Dimaco ha pasado de ser una pequeña ferretería local a una empresa con una fuerte presencia en la región del Maule, gracias a la dedicación y el trabajo duro de la familia Espinoza.**",
            "blockClass": "parrafo__landing"
        }
    },


    "flex-layout.col#dato__14__historia": {
        "title": "dato 3",
        "children": [
            "rich-text#fecha__14__historia",
            "rich-text#texto__14__historia"
        ],
        "props": {
            "blockClass":["dato__historia","mision__vision__card"]
        }
    },
    "rich-text#fecha__14__historia": {
        "title": "fecha",
        "props": {
            "text": "Nuestra Misión",
            "blockClass": ["fecha___historia","mision__vision__card"]
        }
    },
    "rich-text#texto__14__historia": {
        "title": "info",
        "props": {
            "text": "Ofrecer productos y servicios de la mejor calidad a un precio competitivo, contamos con un equipo permanentemente capacitado y motivado para entregar apoyo y soluciones confiables y adecuadas a cada necesidad del cliente, manejamos un variado y completo stock en nuestro centro de distribución y alianzas con nuestros proveedores que nos permiten una entrega oportuna en su domicilio o nuestras tiendas, agregando valor a sus proyectos y construyendo relaciones de largo plazo.",
            "blockClass": "texto___historia"
        }
    }
    ,


    "flex-layout.col#dato__15__historia": {
        "title": "dato 3",
