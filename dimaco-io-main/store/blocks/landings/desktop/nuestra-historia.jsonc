{
    "store.custom#nuestra-historia": {
        "blocks": [
            "responsive-layout.desktop#nuestra-historia",
            "responsive-layout.mobile#nuestra-historia"
        ]
    },
    "responsive-layout.desktop#nuestra-historia": {
        "children": [
            "image#image__banner",
            "flex-layout.row#main__landing__historia"
        ]
    },
    "flex-layout.row#main__landing__historia": {
        "title": "main landing",
        "children": [
            "flex-layout.col#main__landing__historia"
        ],
        "props": {
            "blockClass": "main__landing"
        }
    },
    "flex-layout.col#main__landing__historia": {
        "title": "main landing",
        "children": [
            "flex-layout.col#menu__landing__historia",
            "flex-layout.col#contenido__landing__historia"
        ],
        "props": {
            "blockClass": "main__landing"
        }
    },
    "flex-layout.col#menu__landing__historia": {
        "title": "Contenedor Menu",
        "children": [
            "rich-text#titulo__menu__landing",
            "rich-text#texto__menu__landing",
            "link#terminos__link",
            "link#cambios__link",
            "link#pagos__link",
            "link#politicas__link",
            "link#historia__link__active"
        ],
        "props": {
            "blockClass": "menu__landing"
        }
    },
    "flex-layout.col#contenido__landing__historia": {
        "title": "Contenedor contenido__landing",
        "children": [
            "rich-text#parrafo__1__landing__historia",
            "flex-layout.col#dato__1__historia",
            "flex-layout.col#dato__2__historia",
            "flex-layout.col#dato__3__historia",
            "flex-layout.col#dato__4__historia",
            "flex-layout.col#dato__5__historia",
            "flex-layout.col#dato__6__historia",
            "flex-layout.col#dato__7__historia",
            "flex-layout.col#dato__8__historia",
            "flex-layout.col#dato__9__historia",
            "flex-layout.col#dato__10__historia",
            "flex-layout.col#dato__11__historia",
            "flex-layout.col#dato__12__historia",
            "flex-layout.col#dato__13__historia",
            "rich-text#parrafo__2__landing__historia",
            "flex-layout.col#dato__14__historia",
            "flex-layout.col#dato__15__historia",
            "flex-layout.col#dato__16__historia"
        ],
        "props": {
            "blockClass": "contenido__landing"
        }
    },
    "flex-layout.col#dato__1__historia": {
        "title": "dato 1",
        "children": [
            "rich-text#fecha__1__historia",
            "rich-text#texto__1__historia"
        ],
        "props": {
            "blockClass": "dato__historia"
        }
    },
    "rich-text#fecha__1__historia": {
        "title": "fecha",
        "props": {
            "text": "1977",
            "blockClass": "fecha___historia"
        }
    },
    "rich-text#texto__1__historia": {
        "title": "info",
        "props": {
            "text": "Nace Dimaco a partir de la cooperativa Sodimac en Constitución, fundada por Don Enrique Espinoza Peña y dos socios.",
            "blockClass": "texto___historia"
        }
    },

    "flex-layout.col#dato__2__historia": {
        "title": "dato 2",
        "children": [
            "rich-text#fecha__2__historia",
            "rich-text#texto__2__historia"
        ],
        "props": {
            "blockClass": "dato__historia"
        }
    },
    "rich-text#fecha__2__historia": {
        "title": "fecha",

        "props": {
            "text": "1983",
            "blockClass": ["fecha___historia","fecha___historia__alterno"]
        }
    },
    "rich-text#texto__2__historia": {
        "title": "info",
        "props": {
            "text": "Mario y Enrique Espinoza se integran formalmente al negocio, participando activamente en la venta, despacho, compras y abastecimiento desde Talca, Concepción y Santiago. Esto implicaba maratónicos viajes en los cuales había que hacer permanentes paradas para mojar y enfriar los neumáticos de la camioneta que venía con un gran sobrepeso.",
            "blockClass": "texto___historia"
        }
    },

    "flex-layout.col#dato__3__historia": {
        "title": "dato 3",
        "children": [
            "rich-text#fecha__3__historia",
            "rich-text#texto__3__historia"
        ],
        "props": {
            "blockClass": "dato__historia"
        }
    },
    "rich-text#fecha__3__historia": {
        "title": "fecha",

        "props": {
            "text": "1988",
            "blockClass": ["fecha___historia"/* ,"fecha___historia__alterno" */]
        }
    },
    "rich-text#texto__3__historia": {
        "title": "info",
        "props": {
            "text": "Don Enrique enferma y Mario asume la dirección de la ferretería. Enrique comienza a llevar a su padre a Santiago a recuperar su salud.",
            "blockClass": "texto___historia"
        }
    },

    "flex-layout.col#dato__4__historia": {
        "title": "dato 4",
        "children": [
            "rich-text#fecha__4__historia",
            "rich-text#texto__4__historia"
        ],
        "props": {
            "blockClass": "dato__historia"
        }
    },
    "rich-text#fecha__4__historia": {
        "title": "fecha",
        "props": {
            "text": "1998",
            "blockClass": ["fecha___historia","fecha___historia__alterno"]
        }
    },
    "rich-text#texto__4__historia": {
        "title": "info",
        "props": {
            "text": "Fallece Don Enrique Espinoza Peña, fundador de Dimaco.",
            "blockClass": "texto___historia"
        }
    },

