            "blockClass": ["fecha___historia","mision__vision__card"]
        }
    },
    "rich-text#texto__15__historia": {
        "title": "info",
        "props": {
            "text": "Ser una plataforma de negocios con nuestros clientes y proveedores entregando la mejor experiencia de compra a personas y empresas.",
            "blockClass": "texto___historia"
        }
    },


    "flex-layout.col#dato__16__historia": {
        "title": "dato 3",
        "children": [
            "rich-text#fecha__16__historia",
            "rich-text#texto__16__historia"
        ],
        "props": {
            "blockClass": "dato__historia"
        }
    },
    "rich-text#fecha__16__historia": {
        "title": "fecha",
        "props": {
            "text": "Valores",
            "blockClass": ["fecha___historia","mision__vision__card"]
        }
    },
    "rich-text#texto__16__historia": {
        "title": "info",
        "props": {
            "text": "- Empatía: Sabemos apreciar y respetar los sentimientos y puntos de vista del cliente. \n- Confianza: Somos consecuentes con lo que ofrecemos y entregamos. \n- Puntualidad: Cumplir nuestros compromisos en los tiempos acordados. \n- Flexibilidad: Ofrecemos diferentes alternativas buscando la más apta para cada situación.",
            "blockClass": "texto___historia"
        }
    }
