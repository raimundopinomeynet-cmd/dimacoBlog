{
    "store.custom#terminos-condiciones": {
        "blocks": [
           "responsive-layout.desktop#terminos-condiciones",
           "responsive-layout.mobile#terminos-condiciones"
        ]
    },
    "responsive-layout.desktop#terminos-condiciones": {
        "children": [
            "image#image__banner",
            "flex-layout.row#main__landing"
        ]
    },
      
    
    "image#image__banner": {
        "title": "image banner landing",
        "props": {
            "src": "/arquivos/Banner__contacto.svg",
            "blockClass": "image__banner"
        }
    },
    "flex-layout.row#main__landing": {
        "title": "main landing",
        "children": [
            "flex-layout.col#main__landing"
        ],
        "props": {
            "blockClass": "main__landing"
        }
    },
    "flex-layout.col#main__landing": {
        "title": "main landing",
        "children": [
            "flex-layout.col#menu__landing",
            "flex-layout.col#contenido__landing"
        ],
        "props": {
            "blockClass": "main__landing"
        }
    },
    "flex-layout.col#menu__landing": {
        "title": "Contenedor Menu",
        "children": [
            "rich-text#titulo__menu__landing",
            "rich-text#texto__menu__landing",
            "link#terminos__link__active",
            "link#cambios__link",
            "link#pagos__link",
            "link#politicas__link",
            "link#historia__link"
        ],
        "props": {
            "blockClass": "menu__landing"
        }
    },
    "rich-text#titulo__menu__landing": {
        "title": "Titulo del menu",
        "props": {
            "text": "Tenemos soluciones para ti",
            "blockClass": "titulo__menu__landing"
        }
    },
    "rich-text#texto__menu__landing": {
        "title": "Texto del menu",
        "props": {
            "text": "La venta de cualquiera de los productos publicados está sujeta a la verificación de stock. Los precios online y los planes de financiación para los productos presentados/publicados en www.dimaco.cl son válidos exclusivamente para la compra vía internet en las páginas antes mencionadas.",
            "blockClass": "texto__menu__landing"
        }
    },
    "link#terminos__link__active": {
