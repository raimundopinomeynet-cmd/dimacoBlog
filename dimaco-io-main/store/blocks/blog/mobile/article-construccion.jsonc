{
    "responsive-layout.mobile#blog-construccion": {
        "children": [
            "flex-layout.row#article__header__construccion",
            "flex-layout.row#article__content__construccion__mobile"
        ]
    },
    "flex-layout.row#article__content__construccion__mobile": {
        "title": "Article Content Mobile",
        "children": [
            "flex-layout.col#article__main__construccion"
        ],
        "props": {
            "blockClass": "article__content__mobile"
        }
    }
}
