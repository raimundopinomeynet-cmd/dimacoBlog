    },
    "rich-text#card__text__1": {
        "title": "card__text__1",
        "props": {
            "text": "Herramientas",
            "blockClass": "card__text__destacada"
        }
    },
    "image#card__image__1": {
        "title": "card__image__1",
        "props": {
            "src": "/arquivos/destacada1.jpg",
            "blockClass": "card__image__destacada"
