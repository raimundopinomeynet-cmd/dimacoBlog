{
    "flex-layout.row#mejores__ofertas": {
        "title": "mejores ofertas",
        "children": [
            "flex-layout.col#mejores__ofertas"
        ],
        "props": {
            "blockClass": "mejores__ofertas"
        }
    },
    "flex-layout.col#mejores__ofertas": {
        "title": "mejores ofertas",
        "children": [
            "rich-text#title__mejores__ofertas",
            "rich-text#text__mejores__ofertas",
            "flex-layout.row#imagenes__promos3",
            "flex-layout.row#imagenes__promos4"
        ],
        "props": {
            "blockClass": "mejores__ofertas"
        }
    },
    "rich-text#title__mejores__ofertas": {
        "title": "titulos mejores ofertas",
        "props": {
            "text": "# En Dimaco ofrecemos las mejores ofertas",
            "blockClass": "title__mejores__ofertas"
        }
    },
    "rich-text#text__mejores__ofertas": {
        "title": "texto mejores ofertas",
        "props": {
            "text": "## Todo lo que necesitas en herramientas, pinturas y accesorios para mejorar tu hogar o lugar de trabajo.",
            "blockClass": "text__mejores__ofertas"
        }
    },
    "flex-layout.row#imagenes__promos3": {
        "title": "imagenes__promos3",
